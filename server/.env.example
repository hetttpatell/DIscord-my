# Port for the Express server to listen on
PORT=3001
# Allowed origin for CORS and security checks
CLIENT_ORIGIN=http://localhost:5173
# Secret key used to sign and verify HMAC session tokens
SESSION_SECRET=your_long_session_secret_at_least_32_characters
# WebSocket URL for LiveKit Cloud or self-hosted instance
LIVEKIT_URL=wss://your-project.livekit.cloud
# LiveKit API key for room operations and authentication
LIVEKIT_API_KEY=your_livekit_api_key
# LiveKit API secret for signing access tokens
LIVEKIT_API_SECRET=your_livekit_api_secret
# Google YouTube Data API v3 key for searching videos
YOUTUBE_API_KEY=your_youtube_api_key
# Optional Redis connection URL for room state persistence and clustering
REDIS_URL=

