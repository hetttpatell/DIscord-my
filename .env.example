PORT=3001
# Backend link for frontend in production (e.g. https://your-backend.onrender.com)
VITE_BACKEND_URL=

# Paste your YouTube Data API v3 key below
YOUTUBE_API_KEY=

# =============================================================================
# PEERJS & WEBRTC STUN / TURN CONFIGURATION
# =============================================================================
# PeerJS provides lightweight, mobile-optimized 1-to-1 voice calling.
# STUN/TURN relays are served via /api/webrtc/ice-config for NAT traversal.
# Custom STUN server URLs (comma-separated, optional - defaults to Google and Cloudflare STUN)
STUN_SERVERS=

# Option A: Metered.ca TURN API Key (Free 50GB/month WebRTC TURN relay)
METERED_API_KEY=
# Option A: Metered.ca App Domain (optional, defaults to standard)
METERED_APP_DOMAIN=

# Option B: Custom TURN server URLs (comma-separated, e.g. turn:relay.example.com:3478,turns:relay.example.com:443?transport=tcp)
TURN_URLS=
# Option B: Custom TURN static auth username
TURN_USERNAME=
# Option B: Custom TURN static auth credential/password
TURN_CREDENTIAL=
# Option C: Coturn RFC 5766 HMAC-SHA1 shared secret for dynamic time-limited credentials
TURN_SECRET=

# =============================================================================
# REDIS PERSISTENCE CONFIGURATION (Optional & Auto-detected)
# =============================================================================
# If configured, rooms, queue, playback state, and passwords persist across restarts with 24h TTL.
# If unset, the server falls back to in-memory storage with a startup warning.
REDIS_URL=
