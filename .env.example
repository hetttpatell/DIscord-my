PORT=3001
# Backend link for frontend in production (e.g. https://your-backend.onrender.com)
VITE_BACKEND_URL=

# Paste your YouTube Data API v3 key below
YOUTUBE_API_KEY=

# =============================================================================
# LIVEKIT CLOUD / SELF-HOSTED SFU CONFIGURATION (Optional & Auto-detected)
# =============================================================================
# If configured, the app automatically upgrades real-time conferencing to LiveKit SFU
# (adaptive streaming, dynacast, 100+ concurrent participants).
# If not configured, the app seamlessly runs using the built-in W3C WebRTC engine.
# Sign up for a free cloud project at https://cloud.livekit.io/
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# =============================================================================
# WEBRTC STUN & TURN RELAY CONFIGURATION (Used for Native WebRTC Mesh Fallback)
# =============================================================================
# Default STUN servers are automatically included (Google & Cloudflare STUN)

# Option A: Metered.ca (Free 50GB/month WebRTC TURN relay)
# Sign up at https://www.metered.ca/tools/openrelay/ and paste your API key
METERED_API_KEY=
METERED_APP_DOMAIN=

# Option B: Custom TURN Server (coturn / self-hosted / Twilio / Xirsys)
# TURN_URLS=turn:your-turn-server.com:3478,turn:your-turn-server.com:443?transport=tcp,turns:your-turn-server.com:5349
# TURN_USERNAME=your_username
# TURN_CREDENTIAL=your_password
# Or if using coturn REST API HMAC secret:
# TURN_SECRET=your_turn_hmac_secret

# =============================================================================
# REDIS PERSISTENCE CONFIGURATION (Optional & Auto-detected)
# =============================================================================
# If configured, rooms, queue, playback state, and passwords persist across restarts with 24h TTL.
# If unset, the server falls back to in-memory storage with a startup warning.
REDIS_URL=
